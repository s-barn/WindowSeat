<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="http://www.hardcodet.net/taskbar"
                    xmlns:local="clr-namespace:WindowSeat.App">
    <tb:TaskbarIcon x:Key="TrayIcon"
                    IconSource="/Assets/windowseat.ico"
                    ToolTipText="WindowSeat"
                    MenuActivation="RightClick"
                    DoubleClickCommand="{Binding OpenSettingsCommand, Source={x:Static local:TrayCommands.Instance}}">
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Open Settings"
                          Command="{Binding OpenSettingsCommand, Source={x:Static local:TrayCommands.Instance}}"/>
                <Separator/>
                <MenuItem Header="Enable WindowSeat"
                          IsCheckable="True"
                          IsChecked="{Binding IsEnabled, Source={x:Static local:TrayCommands.Instance}}"
                          Command="{Binding ToggleEnabledCommand, Source={x:Static local:TrayCommands.Instance}}"/>
                <Separator/>
                <MenuItem Header="Check for Updates"
                          Command="{Binding CheckUpdatesCommand, Source={x:Static local:TrayCommands.Instance}}"/>
                <Separator/>
                <MenuItem Header="Exit"
                          Command="{Binding ExitCommand, Source={x:Static local:TrayCommands.Instance}}"/>
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
    </tb:TaskbarIcon>
</ResourceDictionary>
