<Window x:Class="WindowSeat.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WindowSeat Settings"
        Width="480" Height="540"
        MinWidth="420" MinHeight="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A6741"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="DescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#5C7A52"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A6741"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#C0392B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A93226"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="🪑" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WindowSeat" FontSize="20" FontWeight="Bold" Foreground="#3A5232"/>
                <TextBlock x:Name="VersionText" FontSize="11" Foreground="#888"/>
            </StackPanel>
        </StackPanel>

        <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#DDD"/>

        <!-- Settings body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,4,0,0">
            <StackPanel>

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionHeader}"/>

                <CheckBox x:Name="EnabledCheckBox" Content="Enable WindowSeat"
                          Checked="EnabledCheckBox_Changed" Unchecked="EnabledCheckBox_Changed"/>
                <TextBlock Text="When disabled, WindowSeat runs in the background but will not reposition windows."
                           Style="{StaticResource DescriptionText}" Margin="20,0,0,0"/>

                <CheckBox x:Name="StartupCheckBox" Content="Launch at Windows startup"
                          Margin="0,10,0,4"
                          Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/>

                <CheckBox x:Name="UpdatesCheckBox" Content="Notify me when updates are available"
                          Margin="0,4,0,4"
                          Checked="UpdatesCheckBox_Changed" Unchecked="UpdatesCheckBox_Changed"/>

                <!-- Detection method -->
                <TextBlock Text="Monitor Detection" Style="{StaticResource SectionHeader}"/>

                <RadioButton x:Name="CursorRadio" Content="Cursor position"
                             GroupName="DetectionMethod"
                             Checked="DetectionMethod_Changed"/>
                <TextBlock Text="Move new windows to whichever monitor the mouse cursor is on when the window opens."
                           Style="{StaticResource DescriptionText}" Margin="20,0,0,6"/>

                <RadioButton x:Name="TaskbarRadio" Content="Last active taskbar"
                             GroupName="DetectionMethod"
                             Checked="DetectionMethod_Changed"/>
                <TextBlock Text="Move new windows to the monitor whose taskbar was most recently interacted with."
                           Style="{StaticResource DescriptionText}" Margin="20,0,0,0"/>

                <!-- Exclusions -->
                <TextBlock Text="App Exclusions" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="WindowSeat will ignore these applications and not reposition their windows."
                           Style="{StaticResource DescriptionText}" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExclusionTextBox"
                             Grid.Column="0"
                             PlaceholderText="e.g. Spotify.exe"
                             Padding="6,4"
                             FontSize="12"
                             Margin="0,0,6,0"
                             KeyDown="ExclusionTextBox_KeyDown"/>
                    <Button Grid.Column="1" Content="Add"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,0"
                            Click="AddExclusion_Click"/>
                    <Button Grid.Column="2" Content="Browse"
                            Padding="16,6" FontSize="13" BorderThickness="1"
                            Click="BrowseExclusion_Click"/>
                </Grid>

                <ListBox x:Name="ExclusionsList"
                         Margin="0,8,0,0"
                         Height="120"
                         FontSize="12"
                         SelectionMode="Single"/>

                <Button Content="Remove Selected"
                        Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,0"
                        Click="RemoveExclusion_Click"/>

                <!-- About -->
                <TextBlock Text="About" Style="{StaticResource SectionHeader}"/>
                <TextBlock FontSize="12" Foreground="#555" TextWrapping="Wrap">
                    WindowSeat is free and open source software, licensed under the MIT License.<LineBreak/>
                    <Hyperlink x:Name="GitHubLink" RequestNavigate="GitHubLink_RequestNavigate"
                               NavigateUri="https://github.com/stmba/WindowSeat">
                        github.com/stmba/WindowSeat
                    </Hyperlink>
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="16,6" FontSize="13" Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
