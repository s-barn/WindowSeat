<Application x:Class="WindowSeat.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Sage green palette -->
            <Color x:Key="SageDark">#4A6741</Color>
            <Color x:Key="SageMid">#5C7A52</Color>
            <Color x:Key="SageLight">#6B8F61</Color>
            <Color x:Key="SageHighlight">#A8C49E</Color>
            <SolidColorBrush x:Key="SageDarkBrush"      Color="{StaticResource SageDark}"/>
            <SolidColorBrush x:Key="SageMidBrush"       Color="{StaticResource SageMid}"/>
            <SolidColorBrush x:Key="SageLightBrush"     Color="{StaticResource SageLight}"/>
            <SolidColorBrush x:Key="SageHighlightBrush" Color="{StaticResource SageHighlight}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
